  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "vendor/*.tgz"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@aibizhive/dsh-client-ui-aibizhive-skin": "file:./vendor/aibizhive-dsh-client-ui-aibizhive-skin-0.1.3.tgz"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
